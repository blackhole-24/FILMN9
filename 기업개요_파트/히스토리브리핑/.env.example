# ═══════════════════════════════════════════════════════════════════════
# FILMN9 자동화 파이프라인 환경변수 템플릿
#
# 사용법:
#   1. 이 파일을 .env 로 복사
#   2. <...> 부분을 실제 값으로 채움
#   3. .env 는 절대 깃에 올리지 말 것 (.gitignore 처리됨)
# ═══════════════════════════════════════════════════════════════════════

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=<your_openai_api_key>

# ── DART (OpenDART) ───────────────────────────────────────────────────
DART_API_KEY=<your_dart_api_key>

# ── MongoDB Atlas ─────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=filmn9
MONGO_COLLECTION=histories

# ── 저장 모드 ─────────────────────────────────────────────────────────
# local : 로컬 디스크 (automation/data/)
# s3    : AWS S3 (To-be, 현재 미구현)
STORAGE_MODE=local

# ── 로컬 저장 경로 ────────────────────────────────────────────────────
# 기본: automation/data
# 다른 드라이브 쓰려면 절대경로 (예: D:\filmn9_data)
LOCAL_DATA_DIR=

# ── LLM 모델 설정 ─────────────────────────────────────────────────────
LLM_MODEL_1PASS=gpt-5-mini
LLM_MODEL_2PASS=gpt-5.4-mini
LOW_SCORE_THRESHOLD=70

# ── 실행 옵션 ─────────────────────────────────────────────────────────
# 처리 후 임시 파일 (JSONL, XML) 자동 삭제 (브리핑은 보존)
AUTO_CLEANUP=false
