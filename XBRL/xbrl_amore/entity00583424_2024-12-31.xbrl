  <ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents contextRef="BPFY2022eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="0">74669238000</ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents>
  <ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents contextRef="PFY2023eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="0">61774213379</ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents>
  <ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents contextRef="CFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="0">46661703690</ifrs-full:ShorttermDepositsNotClassifiedAsCashEquivalents>
