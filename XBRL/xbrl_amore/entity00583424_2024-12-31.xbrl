  <ifrs-full:CashAndCashEquivalents contextRef="PFY2023eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" unitRef="KRW" decimals="0">506379386493</ifrs-full:CashAndCashEquivalents>
