# ─────────────────────────────────────────────────────────────
# 이 파일을 `.env`로 복사한 뒤 실제 키로 채우세요.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# (필수) DART OpenAPI 키 — https://opendart.fss.or.kr/
# Phase A/B(데이터 수집) 및 auto_update 에 필요. 챗봇만 돌릴 거면 옵션.
DART_API_KEY=your_dart_api_key_here

# (필수) OpenAI API 키 — https://platform.openai.com/api-keys
# 챗봇의 질문분석 + 답변생성에 필요.
OPENAI_API_KEY=your_openai_api_key_here

# (선택) 챗봇 모델 오버라이드 — 미설정 시 코드 기본값 사용
# CHATBOT_OPENAI_MODEL=gpt-5.4-mini
# CHATBOT_ANALYZER_MODEL=gpt-5.4-mini

# (선택) 재랭커 모델을 오프라인(local files only)로 강제하려면 "1"
# CHATBOT_RERANKER_LOCAL_ONLY=0
