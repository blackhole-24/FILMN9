# ─────────────────────────────────────────────────────────────
# API 키 설정 — 실제 값으로 채운 뒤 .env 로 복사하세요:
#     cp .env.example .env   (Windows: copy .env.example .env)
# ⚠ .env 는 .gitignore 로 제외됩니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# DART 전자공시 OpenAPI (재무제표·사업보고서)
#   발급: https://opendart.fss.or.kr/
DART_API_KEY=

# 한국은행 ECOS (국고채 10년물 = 무위험수익률 Rf)
#   발급: https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# KRX 데이터 OpenAPI (주가·지수·시가총액)
#   발급: https://data.krx.co.kr/
krxdata=

# OpenAI (신용등급·주식수 RAG 추출 — gpt-4o-mini)
#   발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
