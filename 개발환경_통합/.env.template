# ════════════════════════════════════════════════════════════════
#  FILMN9 환경변수 템플릿
#  ─ 사용법 ──────────────────────────────────────────────────────
#  1) 이 파일을 프로젝트 루트(FILMN9/)에 .env 이름으로 복사
#     Windows: copy 개발환경_통합\.env.template ..\.env
#     Mac/Linux: cp 개발환경_통합/.env.template ../.env
#  2) 아래 각 키의 값을 본인 것으로 채워 넣을 것
#  3) .env 는 절대 Git에 커밋 금지 (.gitignore 등록됨)
# ════════════════════════════════════════════════════════════════

# ─── DART OpenAPI ───
# 발급: https://opendart.fss.or.kr/ → 회원가입 → 인증키 신청 (무료, 1분)
DART_API_KEY=여기에_DART_API_키_입력

# ─── 한국은행 ECOS API ───
# 발급: https://ecos.bok.or.kr/api/ → 회원가입 → 인증키 신청
ECOS_API_KEY=여기에_ECOS_API_키_입력

# ─── OpenAI ───
# 발급: https://platform.openai.com/api-keys
# 팀 공용 키는 팀 리더에게 요청
OPENAI_API_KEY=여기에_OPENAI_API_키_입력

# ─── MySQL DB (선택: 일부 모듈만 사용) ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veda_db
DB_USER=root
DB_PASS=여기에_DB_비밀번호_입력

# ─── MongoDB Atlas (히스토리 브리핑) ───
# Atlas 가입 후 connection string 발급 받아서 아래에 입력
# 형식: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 팀 공용 클러스터는 팀 리더에게 요청
MONGO_URI=여기에_MONGO_URI_입력
MONGO_DB=filmn9
MONGO_COLLECTION=histories
